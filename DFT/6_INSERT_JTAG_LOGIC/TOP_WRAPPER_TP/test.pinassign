assign pin=PIN_comp_en 	test_function= -SE; 	# compression_enable
assign pin=PIN_mask_en 	test_function= -SE; 	# mask_enable
assign pin=PIN_mask_load 	test_function= +SE; 	# mask_load
assign pin=PIN_spread_en 	test_function= -SE; 	# spread_enable
assign pin=PIN_TestMode 	test_function= +TI; 	# test_mode
assign pin=PIN_RST_N 	test_function= -SC; 	# test_mode
assign pin=PIN_TRST 	test_function= -TI; 	# test_mode
assign pin=PIN_ScanEnable 	test_function= +SE; 	# shift_enable
assign pin=PIN_REF_CLK 	test_function= -ES; 	
assign pin=PIN_UART_CLK 	test_function= -ES; 	
assign pin=PIN_mask_clk 	test_function= -ES; 	# mask_clock
assign pin=PIN_TCK 	test_function= -ES; 	
assign pin=PIN_ScanIn_1 	test_function= SI0;
assign pin=PIN_ScanOut_1 	test_function= SO0;
assign pin=PIN_ScanIn_2 	test_function= SI1;
assign pin=PIN_ScanOut_2 	test_function= SO1;
